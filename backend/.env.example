# Environment Configuration for SmartRetail-Sync

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=local
APP_NAME=SmartRetail-Sync
DEBUG=True
LOG_LEVEL=DEBUG

# ============================================
# DATABASE SETTINGS (PostgreSQL)
# ============================================
# Local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartretail_db
DB_USER=smartretail_user
DB_PASSWORD=your_secure_password_here

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# ============================================
# AZURE KEY VAULT (Production only)
# ============================================
# Set these in production environment
AZURE_KEYVAULT_URL=https://your-vault-name.vault.azure.net/
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ============================================
# API SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# MONITORING
# ============================================
ENABLE_TELEMETRY=False
APPLICATION_INSIGHTS_KEY=
